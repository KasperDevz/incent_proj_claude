# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# Admin auth mode: "basic" (email+password) | "azure" (Azure AD SSO)
ADMIN_AUTH_MODE="basic"

# Azure AD — required only when ADMIN_AUTH_MODE=azure
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Email service for OTP delivery (leave empty to show OTP on login UI instead)
EMAIL_SERVICE_URL=""
EMAIL_SERVICE_KEY=""

# ─── AWS API Gateway ──────────────────────────────────────────────────────────
AWS_API_GATEWAY_URL=""
AWS_API_GATEWAY_KEY=""

# ─── External Sales API ───────────────────────────────────────────────────────
# Phase 2 only — leave empty for local mock mode
EXTERNAL_API_URL=""
EXTERNAL_API_KEY=""

# ─── Local Database (Docker Compose — schema reference & migrations only) ─────
DATABASE_URL="postgresql://incent:incent@localhost:5432/incent_dev"
